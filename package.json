{
  "name": "cat-30-day-sprint",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "30-day CAT preparation app: 300 original questions, trend analysis, priority scores, study plan, sectional tests. React + TypeScript + Vite + Tailwind, localStorage only.",
  "scripts": {
    "data": "python3 content/build_data.py",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:offline": "node scripts/build-offline.mjs",
    "test": "node scripts/test-logic.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
