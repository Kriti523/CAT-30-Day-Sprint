# Optional: accounts & sync through Supabase (see README → Accounts & Sync).
# Copy to .env.local and fill in from your Supabase project's API settings. Leave empty for no sign-in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: paid access (needs the Supabase settings above, the entitlements table in supabase/schema.sql and the
# claim-license function). Until a Gumroad license key is verified, the app runs as a 20-question free sample.
VITE_REQUIRE_PURCHASE=false
# Your Gumroad product page, for the "Buy full access" button.
VITE_BUY_URL=
# Shown in the footer and legal pages. Without it, people are pointed to the Gumroad product page.
VITE_SUPPORT_EMAIL=

# Where the app is hosted (e.g. https://catsprint.example.com), for link previews on WhatsApp and elsewhere.
VITE_SITE_URL=
# Optional cookieless visit counts with Plausible (plausible.io): the domain you registered there.
VITE_PLAUSIBLE_DOMAIN=
